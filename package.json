{
  "name": "leaguelogin",
  "version": "1.13.2",
  "description": "Lost League Manager",
  "main": "src/main/main.js",
  "scripts": {
    "start": "ow-electron .",
    "build": "ow-electron-builder",
    "test": "node --test \"test/**/*.test.js\""
  },
  "author": "Lostgames",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/MouseWerk/lost-league-manager.git"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.5.1",
    "axios": "^1.21.1",
    "electron-updater": "^6.8.11",
    "js-yaml": "^4.3.2",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@overwolf/ow-electron": "^37.10.3",
    "@overwolf/ow-electron-builder": "^26.18.2"
  },
  "overwolf": {
    "packages": [
      "gep",
      "overlay"
    ]
  },
  "build": {
    "appId": "com.lostgames.leaguelogin",
    "productName": "Lost League Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!test/**",
      "!docs/**"
    ],
    "extraResources": [
      "resources/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MouseWerk",
        "repo": "lost-league-manager",
        "releaseType": "release"
      }
    ],
    "overwolf": {
      "requireSigning": false
    }
  },
  "overrides": {
    "lodash": "^4.18.1",
    "minimatch@>=7.0.0 <11.0.1": "^11.0.1"
  }
}
